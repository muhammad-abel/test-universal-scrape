# LiteLLM Configuration
# Copy this file to .env and fill in your actual values

# LiteLLM API Base URL (your proxy endpoint)
# Example: https://proxy.ximplify.id
LITELLM_API_BASE=https://your-proxy-url-here

# LiteLLM API Key
LITELLM_API_KEY=sk-your-api-key-here

# LiteLLM Model
# Examples: openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3-haiku-20240307
# Choose an economical model with JSON output support
LITELLM_MODEL=openai/gpt-4o-mini

# Optional: Enable debug logging
# DEBUG=true
